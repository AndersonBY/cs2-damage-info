<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>HybridDamageInfo</AssemblyName>
        <RootNamespace>HybridDamageInfo</RootNamespace>
        <Version>5.0.1</Version>
        <AssemblyVersion>5.0.1.0</AssemblyVersion>
        <FileVersion>5.0.1.0</FileVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CounterStrikeSharp.API" Version="1.0.371" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\lang\**\*.json" Link="lang\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
